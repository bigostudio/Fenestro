APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── WhatsApp Business Cloud API (Send Statement → "Send PDF via WhatsApp") ──
# Receivables / Archive → Send Statement → "Send PDF via WhatsApp" sends the statement PDF as a
# WhatsApp document to the customer's registered number. It needs WHATSAPP_TOKEN,
# WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_SENDING_ENABLED=true; without them the button is disabled
# and the reason is shown (the manual Share PDF / Share Chat options still work). Never put these
# in the frontend.
#   WHATSAPP_TOKEN            permanent System User access token (Meta Business Settings → System users)
#                             with whatsapp_business_messaging (+ whatsapp_business_management) permissions
#   WHATSAPP_PHONE_NUMBER_ID  the "Phone number ID" (not the phone number) from App Dashboard → WhatsApp → API Setup
# Check with: php artisan whatsapp:check   (add --to=YOUR_NUMBER to receive Meta's hello_world test)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Master switch: no automatic WhatsApp message is sent until this is true (set it only after
# "php artisan whatsapp:check --to=YOUR_NUMBER" succeeds)
WHATSAPP_SENDING_ENABLED=false
WHATSAPP_API_VERSION=v21.0
# WhatsApp Business Account ID — optional, lets whatsapp:check confirm the template status
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Approved UTILITY template: DOCUMENT header + body variables {{1}} customer, {{2}} project,
# {{3}} invoice, {{4}} received, {{5}} outstanding. Needed to message customers who have not
# written to you in the last 24 hours. Language code must match the template exactly (e.g. en, en_US).
WHATSAPP_STATEMENT_TEMPLATE=
WHATSAPP_STATEMENT_TEMPLATE_LANG=en
# Action Hub "service request received" message (Snag, Service, Scheduled Measurements,
# Scheduled Installation). Approved UTILITY template, no header, body text exactly as in
# config/action_hub.php with {{1}} customer name, {{2}} service type, {{3}} ticket number.
# Empty: sent as a plain message, which WhatsApp only delivers within 24 hours of the customer's last message.
WHATSAPP_ACTION_HUB_TEMPLATE=
WHATSAPP_ACTION_HUB_TEMPLATE_LANG=en
# Statement messages for Send Statement (on by default; set false to switch them off)
CNS_STATEMENT_DRAFTS=true
# Google review link put into the CNS "FEEDBACK REQ" WhatsApp draft (a public link, not a secret).
# Prestige Ventures' official link: https://g.page/r/CSU2H9tOGNG0EBE/review
# Left empty, FEEDBACK REQ still saves but the draft explains that the link is missing.
CNS_GOOGLE_REVIEW_URL=
# Delivery status (delivered / read) — optional. In the Meta app: WhatsApp → Configuration → Webhook:
#   Callback URL  https://<your-api-domain>/api/whatsapp/webhook
#   Verify token  the same value as WHATSAPP_VERIFY_TOKEN (choose a long random string)
#   Subscribe to the "messages" field.
# WHATSAPP_APP_SECRET is the App secret from App settings → Basic (used to check Meta's signature).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# While testing: send EVERY message to this number instead of the customer's (leave empty in production)
WHATSAPP_DRAFT_TEST_RECIPIENT=
